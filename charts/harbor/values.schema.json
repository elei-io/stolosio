{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["database", "nats"],
  "properties": {
    "database": {
      "type": "object",
      "required": ["existingSecret", "urlSecretKey"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "urlSecretKey": {"type": "string", "minLength": 1}
      }
    },
    "nats": {
      "type": "object",
      "required": ["existingSecret", "urlSecretKey"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "urlSecretKey": {"type": "string", "minLength": 1},
        "seedSecretKey": {"type": "string"}
      }
    },
    "migration": {
      "type": "object",
      "required": ["ttlSecondsAfterFinished"],
      "properties": {
        "ttlSecondsAfterFinished": {"type": "integer", "minimum": 0}
      }
    },
    "monitoring": {
      "type": "object",
      "required": ["enabled", "service", "serviceMonitor"],
      "properties": {
        "enabled": {"type": "boolean"},
        "service": {
          "type": "object",
          "required": ["annotations", "labels"],
          "properties": {
            "annotations": {"type": "object"},
            "labels": {"type": "object"}
          }
        },
        "serviceMonitor": {
          "type": "object",
          "required": ["enabled", "interval", "scrapeTimeout", "labels"],
          "properties": {
            "enabled": {"type": "boolean"},
            "interval": {"type": "string", "minLength": 1},
            "scrapeTimeout": {"type": "string", "minLength": 1},
            "labels": {"type": "object"}
          }
        }
      }
    }
  }
}
