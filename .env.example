# Optional overrides. The local Compose stack works without copying this file.
# Fleet limits and routing policy are configured in the UI and stored in PostgreSQL.

# Host-side tools (tests and the Docker fleet controller).
DATABASE_URL=postgresql+asyncpg://stolosio:stolosio@localhost:5433/stolosio
NATS_URL=nats://localhost:4223
HEALTH_STOLOSIO_CDP_URL=ws://localhost:8411/v1/connect

# Local published ports; bound to localhost by Compose.
STOLOSIO_API_PORT=8411
STOLOSIO_WEB_PORT=5173
STOLOSIO_POSTGRES_PORT=5433

# Optional paid provider. Keep real credentials in .env, never in Git.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Process limits. See backend/settings.py for all supported settings.
STOLOSIO_MAX_ACTIVE_SESSIONS=100
PROVIDER_ACQUISITION_TIMEOUT_SECONDS=30
PROVIDER_QUEUE_TIMEOUT_SECONDS=30
HTTP_REQUEST_TIMEOUT_SECONDS=20
HTTP_MAX_RESPONSE_BYTES=10485760
FLEET_CONTROLLER_METRICS_PORT=9101
