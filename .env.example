APP_NAME=Harbor
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://harbor:harbor@localhost:5433/harbor
HARBOR_POSTGRES_PORT=5433
NATS_URL=nats://localhost:4223
BROWSERLESS_URL=ws://localhost:3000
CAMOUFOX_URL=ws://localhost:1234/harbor
CHROMIUM_URL=ws://chromium:9222
LIGHTPANDA_URL=ws://localhost:9222
HARBOR_MAX_ACTIVE_SESSIONS=100
PROVIDER_QUEUE_TIMEOUT_SECONDS=30
HTTP_MAX_ACTIVE_SESSIONS=100
HTTP_MAX_QUEUED_ATTEMPTS=100
HTTP_REQUEST_TIMEOUT_SECONDS=20
HTTP_MAX_RESPONSE_BYTES=10485760
HTTP_USER_AGENT=HarborBot/0.1 (https://github.com/ekkuleivonen/harbor)
HTTP_ACCEPT=text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8
HTTP_ACCEPT_LANGUAGE=en-US,en;q=0.5
NO_BROWSER_REPLAY_MAX_COMMANDS=100
NO_BROWSER_REPLAY_MAX_BYTES=2097152
NO_BROWSER_REPLAY_TIMEOUT_SECONDS=30
CHROMIUM_MINIMUM_INSTANCES=1
CHROMIUM_MAXIMUM_INSTANCES=4
CHROMIUM_SESSION_CAPACITY_PER_INSTANCE=4
CHROMIUM_SCALE_DOWN_COOLDOWN_SECONDS=30
CHROMIUM_MAX_QUEUED_ATTEMPTS=100
LIGHTPANDA_MINIMUM_INSTANCES=1
LIGHTPANDA_MAXIMUM_INSTANCES=4
LIGHTPANDA_SESSION_CAPACITY_PER_INSTANCE=1
LIGHTPANDA_SCALE_DOWN_COOLDOWN_SECONDS=30
FLEET_RECONCILE_INTERVAL_SECONDS=1
FLEET_OBSERVATION_TTL_SECONDS=5
FLEET_INSTANCE_STARTUP_TIMEOUT_SECONDS=30
FLEET_CONTROLLER_METRICS_PORT=9101
CHROMIUM_FLEET_COMPOSE_SERVICE=chromium
LIGHTPANDA_FLEET_COMPOSE_SERVICE=lightpanda
