---
import "@fontsource-variable/geist";
import "../styles/home.css";
const repo = "https://github.com/elei-io/stolosio";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Keep your automation. Use only the browser you need. Stolosio is an open-source, self-hosted browser gateway with one CDP endpoint."
    />
    <meta name="theme-color" content="#101410" />
    <title>Stolosio — Your browser fleet. One endpoint.</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header wrap">
      <a class="brand" href="/" aria-label="Stolosio home"
        ><span class="brand-mark" aria-hidden="true">≋</span> stolosio<span
          class="brand-dot">.</span
        ></a
      >
      <nav aria-label="Main navigation">
        <a href="#how-it-works">How it works</a><a href="/docs/"
          >Documentation</a
        ><a class="github-link" href={repo}
          >GitHub <span aria-hidden="true">↗</span></a
        >
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap">
        <div class="hero-copy">
          <a class="eyebrow release" href="/docs/"
            ><span class="status-dot"></span> OPEN SOURCE. SELF HOSTED. <span
              aria-hidden="true">↗</span
            ></a
          >
          <h1>Your browser fleet.<br /><span>One endpoint.</span></h1>
          <p class="hero-description">
            Keep your automation. Use only the browser you need.
          </p>
          <p class="hero-detail">
            A gateway that starts lightweight, reaches for a browser when
            needed, and puts you in control of the fleet.
          </p>
          <div class="actions">
            <a class="button primary" href="/docs/quickstart/"
              >Deploy Stolosio <span aria-hidden="true">↗</span></a
            ><a class="button secondary" href={repo}
              >Explore the source <span aria-hidden="true">↗</span></a
            >
          </div>
          <div class="hero-meta">
            <span>MIT licensed</span><span>CDP compatible</span><span
              >Your infrastructure</span
            >
          </div>
        </div>
        <div
          class="gateway"
          aria-label="Illustration: a CDP client connects to Stolosio, which can use HTTP, a managed browser, or optional paid fallback"
        >
          <div class="diagram-heading">
            <span>ACQUISITION, ORCHESTRATED</span><span class="diagram-tag"
              >THE ROUTING MODEL</span
            >
          </div>
          <div class="client-node">
            <span class="node-icon">⌘</span><div>
              <strong>Your automation</strong><span
                >Playwright · CDP clients</span
              >
            </div><span class="node-label">CLIENT</span>
          </div>
          <div class="connector"><span>WS /v1/connect</span></div>
          <div class="gateway-node">
            <span class="mini-mark">≋</span><strong>stolosio</strong><span
              >One connection. A considered route.</span
            ><i></i>
          </div>
          <div class="branch-lines" aria-hidden="true">
            <i></i><i></i><i></i>
          </div>
          <div class="provider-nodes">
            <div class="provider-node active">
              <span class="provider-index">01 / LIGHTWEIGHT</span><strong
                >HTTP</strong
              ><span>Skip the browser<br />when you can.</span><div
                class="node-footer"
              >
                <b></b> BOUNDED HTML PATH
              </div>
            </div>
            <div class="provider-node">
              <span class="provider-index">02 / MANAGED</span><strong
                >Browserless</strong
              ><span>Your browser fleet.<br />Your capacity.</span><div
                class="node-footer"
              >
                <b></b> NATIVE CDP
              </div>
            </div>
            <div class="provider-node">
              <span class="provider-index">03 / OPTIONAL</span><strong
                >Browserbase</strong
              ><span>Paid fallback.<br />Explicitly enabled.</span><div
                class="node-footer"
              >
                <b></b> NATIVE CDP
              </div>
            </div>
          </div>
          <div class="diagram-note">
            <span aria-hidden="true">↳</span> Correct acquisition comes first. Efficiency
            follows.
          </div>
        </div>
      </section>
      <div class="compatibility wrap">
        <span>BUILT AROUND WHAT YOU ALREADY USE</span><div>
          <strong>Playwright</strong><strong>Chrome DevTools Protocol</strong
          ><strong>Docker</strong><strong>Kubernetes</strong>
        </div>
      </div>
      <section class="intro-section wrap" id="how-it-works">
        <div class="section-heading">
          <span class="eyebrow">LESS BROWSER. MORE INTENT.</span><h2>
            A browser is a tool.<br />Not always the first step.
          </h2><p>
            Some pages only need an HTTP request. Others need the whole browser.
            Stolosio gives both paths a single front door.
          </p>
        </div>
        <div class="benefits">
          <article>
            <span class="feature-number">01</span><h3>Start with less.</h3><p>
              Retrieve HTML through a bounded HTTP path. Automatic sessions can
              escalate when the page or your next command needs a browser.
            </p><a href="/docs/providers/"
              >Understand acquisition <span aria-hidden="true">↗</span></a
            >
          </article>
          <article>
            <span class="feature-number">02</span><h3>Keep your code.</h3><p>
              Point your CDP-compatible client at Stolosio. Native browser
              traffic passes through, with the browser in charge of command
              semantics.
            </p><a href="/docs/clients/"
              >Connect your client <span aria-hidden="true">↗</span></a
            >
          </article>
          <article>
            <span class="feature-number">03</span><h3>Own the decisions.</h3><p>
              Set fleet limits, inspect sessions, and control paid fallback.
              Domain evidence helps guide future routes on your own
              installation.
            </p><a href="/docs/operations/"
              >Explore fleet operations <span aria-hidden="true">↗</span></a
            >
          </article>
        </div>
      </section>
      <section class="code-section wrap">
        <div>
          <span class="eyebrow">A SMALL CHANGE TO GET STARTED</span><h2>
            New endpoint.<br />Familiar workflow.
          </h2><p>
            Connect Playwright to your local Stolosio instance, open a page, and
            retrieve its content. No Stolosio SDK required.
          </p><a class="text-link" href="/docs/quickstart/"
            >Run your first session <span aria-hidden="true">→</span></a
          >
        </div>
        <div class="code-window">
          <div class="code-title">
            <span><i></i> first_session.py</span><button
              id="copy-code"
              type="button"
              aria-label="Copy Python example">Copy code</button
            >
          </div><pre><code id="example-code"><span class="code-purple">async with</span> async_playwright() <span class="code-purple">as</span> p:
    browser = <span class="code-purple">await</span> p.chromium.connect_over_cdp(
        <span class="code-green">"ws://localhost:8411/v1/connect"</span>
    )
    page = <span class="code-purple">await</span> browser.new_page()
    <span class="code-purple">await</span> page.goto(<span class="code-green">"https://example.com"</span>)
    html = <span class="code-purple">await</span> page.content()
    <span class="code-purple">await</span> browser.close()</code></pre><div
            class="code-foot"
          >
            <span class="status-dot"></span> Python · Playwright <span
              >Full runnable example in the docs ↗</span
            >
          </div><span class="sr-only" id="copy-status" aria-live="polite"
          ></span>
        </div>
      </section>
      <section class="deployment wrap">
        <div class="section-heading">
          <span class="eyebrow">AT HOME ON YOUR INFRASTRUCTURE</span><h2>
            Start local. Bring your fleet.
          </h2><p>
            From a first session on your laptop to your own Kubernetes cluster.
          </p>
        </div>
        <div class="deploy-grid">
          <a href="/docs/quickstart/" class="deploy-card"
            ><span class="deploy-symbol" aria-hidden="true">▤</span><div>
              <span class="eyebrow">GET STARTED</span><h3>Docker Compose</h3><p>
                A local stack with PostgreSQL, NATS, and managed Browserless
                workers. No paid provider credentials required.
              </p>
            </div><span class="arrow" aria-hidden="true">↗</span></a
          ><a href="/docs/kubernetes/" class="deploy-card"
            ><span class="deploy-symbol" aria-hidden="true">⎈</span><div>
              <span class="eyebrow">RUN YOUR OWN CLUSTER</span><h3>
                Kubernetes & k3s
              </h3><p>
                Deploy with Helm and a dedicated fleet controller. Bring your
                PostgreSQL, NATS, and networking.
              </p>
            </div><span class="arrow" aria-hidden="true">↗</span></a
          >
        </div>
      </section>
      <section class="closing wrap">
        <div>
          <span class="eyebrow">BUILT IN THE OPEN</span><h2>
            Your fleet. Your rules.
          </h2><p>
            Stolosio is experimental software for local development and trusted
            networks. Explore it, run it, and help shape what comes next.
          </p>
        </div><a class="button primary" href="/docs/"
          >Read the documentation <span aria-hidden="true">↗</span></a
        >
      </section>
    </main>
    <footer class="wrap">
      <a class="brand" href="/">≋ stolosio.</a><span
        >An open-source project by <a href="https://elei.io">elei.io</a></span
      ><div>
        <a href="/docs/security/">Security</a><a
          href="https://github.com/elei-io/stolosio/blob/main/LICENSE"
          >MIT License</a
        ><a href={repo}>GitHub ↗</a>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>("#copy-code");
      button?.addEventListener("click", async () => {
        const text = document.querySelector("#example-code")?.textContent ?? "";
        const status = document.querySelector("#copy-status");
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = "Copied!";
          if (status) status.textContent = "Python example copied.";
        } catch {
          button.textContent = "Select code to copy";
          if (status)
            status.textContent =
              "Clipboard unavailable. Select and copy the example.";
        }
        window.setTimeout(() => {
          button.textContent = "Copy code";
        }, 2500);
      });
    </script>
  </body>
</html>
